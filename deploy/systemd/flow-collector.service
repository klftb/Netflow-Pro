[Unit]
Description=NetFlow/IPFIX to ZeroMQ and ClickHouse Flow Collector Bridge
After=network.target clickhouse-server.service
Wants=clickhouse-server.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/flow-pipeline
ExecStart=/usr/bin/python3 /opt/flow-pipeline/flow_collector.py --udp-port 2055 --zmq-endpoint tcp://127.0.0.1:5556 --ch-endpoint "http://127.0.0.1:8123/?query=INSERT+INTO+ntopng.flows_raw+FORMAT+JSONEachRow"
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
